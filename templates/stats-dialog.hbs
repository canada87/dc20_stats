<div class="dc20_stats">
  {{#if hasStats}}

    <div class="cs-header">
      <span class="cs-combat-name">{{name}}</span>
      <span class="cs-meta">Round {{rounds}} &nbsp;|&nbsp; {{summary.enemyCount}} {{#if (eq summary.enemyCount 1)}}enemy{{else}}enemies{{/if}}</span>
    </div>

    {{#if party.length}}
    <h3 class="cs-section-title">Party</h3>
    <table class="cs-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th title="Total damage dealt">Dmg Dealt</th>
          <th title="Average damage per round">Avg/Round</th>
          <th title="Total damage taken">Dmg Taken</th>
          <th title="Healing provided to others">Healed</th>
          <th title="Healing received">Recv. Heal</th>
        </tr>
      </thead>
      <tbody>
        {{#each party}}
        <tr>
          <td class="cs-name">{{name}}</td>
          <td class="cs-type">{{type}}</td>
          <td class="cs-num cs-dealt">{{damageDealt}}</td>
          <td class="cs-num cs-avg">{{avgDmgPerRound}}</td>
          <td class="cs-num cs-taken">{{damageTaken}}</td>
          <td class="cs-num cs-healed">{{healingDone}}</td>
          <td class="cs-num">{{healingReceived}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if enemies.length}}
    <h3 class="cs-section-title">Enemies</h3>
    <table class="cs-table">
      <thead>
        <tr>
          <th>Name</th>
          <th title="Damage taken from party">Dmg Taken</th>
          <th title="Healing received">Recv. Heal</th>
        </tr>
      </thead>
      <tbody>
        {{#each enemies}}
        <tr>
          <td class="cs-name">{{name}}</td>
          <td class="cs-num cs-taken">{{damageTaken}}</td>
          <td class="cs-num">{{healingReceived}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    <div class="cs-summary">
      <div class="cs-summary-item">
        <span class="cs-label">Total Dmg Dealt</span>
        <span class="cs-value cs-dealt">{{summary.totalDealt}}</span>
      </div>
      <div class="cs-summary-item">
        <span class="cs-label">Total Dmg Taken</span>
        <span class="cs-value cs-taken">{{summary.totalTaken}}</span>
      </div>
      <div class="cs-summary-item">
        <span class="cs-label">Total Healing</span>
        <span class="cs-value cs-healed">{{summary.totalHealing}}</span>
      </div>
      <div class="cs-summary-item">
        <span class="cs-label">Avg Dmg / Enemy</span>
        <span class="cs-value">{{summary.avgDmgPerEnemy}}</span>
      </div>
    </div>

    <div class="cs-actions">
      <button data-action="export">
        <i class="fa-solid fa-file-lines"></i> Export TXT
      </button>
    </div>

  {{else}}
    <p class="cs-empty">No combat data yet. Start a combat to begin tracking.</p>
  {{/if}}
</div>
